@page "/inventory"
@attribute [Authorize]

@inject InventoriesClient InventoriesClient
@inject NavigationManager NavigationManager

@rendermode InteractiveServer
@* @attribute [StreamRendering] *@

<PageTitle>All Inventories</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Inventory List</h3>
        <button class="btn btn-primary" @onclick="RedirectToForm">
            <i class="bi bi-plus-lg"></i>
            Add Inventory
        </button>
    </div>
</div>
<div class="container">
    @if (_inventories is null)
    {
        <p>No inventory records found</p>
    }
    else
    {
        <EditForm Model="@SearchParams" Enhance OnValidSubmit="SearchSubmitAsync" FormName="SearchList">
            <div class="row my-5">
                <div class="col-md-6">
                    <InputText DisplayName="Inventory Name" class="form-control" @bind-Value="SearchParams.InventoryName" />
                </div>
                <div class="col-md-2">
                    <InputDate DisplayName="Created Date From" class="form-control" @bind-Value="SearchParams.CreatedDateFrom"></InputDate>
                </div>
                <div class="col-md-2">
                    <InputDate DisplayName="Created Date To" class="form-control" @bind-Value="SearchParams.CreatedDateTo"></InputDate>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </div>
        </EditForm>

        <table class="table table-bordered table-striped table-responsive table-hover mt-5">
            <thead class="table-dark">
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Quantity
                </th>
                <th>
                    Type
                </th>
                <th>
                    Price
                </th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var inventory in _inventories)
            {
                <InventoryListItem Inventory="inventory" OnParentReloadRequested="@ReloadParent" />
            }
            </tbody>
        </table>
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" aria-label="Previous" @onclick="@(() => GetListData(
                                                                             _currentPage - 2,
                                                                             _pageSize, 
                                                                             SearchParams?.InventoryName, 
                                                                             SearchParams?.CreatedDateFrom, 
                                                                             SearchParams?.CreatedDateTo
                                                                         ))">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                @for (var i = 1; i <= _pagesCount; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(_currentPage == i ? "active" : "")">
                        <a class="page-link" @onclick="@(() => GetListData(
                                                    pageIndex - 1,
                                                           _pageSize, 
                                                           SearchParams?.InventoryName, 
                                                           SearchParams?.CreatedDateFrom, 
                                                           SearchParams?.CreatedDateTo
                                                                         ))">
                    @i
                        </a>
                    </li>

                }
                <li class="page-item @(_currentPage == _pagesCount ? "disabled" : "")">
                    <a class="page-link" aria-label="Next" @onclick="@(() => GetListData(
                                                                         _currentPage,
                                                                         _pageSize, 
                                                                         SearchParams?.InventoryName, 
                                                                         SearchParams?.CreatedDateFrom, 
                                                                         SearchParams?.CreatedDateTo
                                                                     ))">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@code {
    private InventoryDto[]? _inventories;
    private int _currentPage = 1, _pageSize = 10;
    private long _pagesCount, _totalRecords;
    [SupplyParameterFromForm] private SearchParams? SearchParams { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetListData(_currentPage - 1, _pageSize);
        SearchParams = new SearchParams();
        await base.OnInitializedAsync();
    }

    private async Task GetListData(int pageIndex, int pageSize, string? inventoryName = null, DateTime? createdDateFrom = null, DateTime? createdDateTo = null)
    {
        Console.WriteLine($"Fetching inventories for page {pageIndex+1} with size {pageSize}");
        var result = await InventoriesClient.GetInventories(pageIndex, pageSize, inventoryName, createdDateFrom, createdDateTo);
        _inventories = result.Items.ToArray();
        _currentPage = result.PageIndex + 1; // FIXME
        _pageSize = result.PageSize;
        _totalRecords = result.Count;
        _pagesCount = (int)Math.Ceiling((double)_totalRecords / _pageSize);
    }

    private async Task SearchSubmitAsync()
    {
        Console.WriteLine("Searching for the meaning of life....");
        if(SearchParams is null) return;
        await HandleSearchAsync(SearchParams.InventoryName, SearchParams.CreatedDateFrom, SearchParams.CreatedDateTo);
    }

    private async Task HandleSearchAsync(string? inventoryName = null, DateTime? createdDateFrom = null, DateTime? createdDateTo = null)
    {
        _currentPage = 1;
        _pageSize = 10;
        await GetListData(_currentPage - 1, _pageSize, inventoryName, createdDateFrom, createdDateTo);
    }

    private void RedirectToForm()
    {
        NavigationManager.NavigateTo("/inventory/create");
    }

    private async Task ReloadParent()
    {
        await GetListData(_currentPage - 1, _pageSize);
        StateHasChanged();
    }

}