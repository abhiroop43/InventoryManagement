@page "/inventory/create"
@page "/inventory/edit/{inventoryId:guid}"

@rendermode InteractiveServer
@inject InventoriesClient InventoriesClient
@inject NavigationManager NavigationManager

@if (InventoryId == null)
{
    <h3>Add Inventory</h3>
    <PageTitle>Add Inventory</PageTitle>
}
else
{
    <h3>Edit Inventory: @InventoryId</h3>
    <PageTitle>Edit Inventory</PageTitle>
}

<EditForm Model="@Inventory" OnValidSubmit="HandleSubmitAsync" FormName="EditInventory" class="row" Enhance>
    <div class="col-md-4"></div>
    <div class="col-md-4">
        <div class="mb-3">
            <label for="inventoryName" class="form-label">Inventory Name</label>
            <input type="text" class="form-control" id="inventoryName" aria-describedby="inventoryNameHelp">
            <div id="inventoryNameHelp" class="form-text">Please provide a valid inventory name</div>
        </div>
        <div class="mb-3">
            <label for="quantity" class="form-label">Quantity</label>
            <input type="number" class="form-control" id="quantity" aria-describedby="quantityHelp">
            <div id="quantityHelp" class="form-text">Please provide a quantity greater than 0</div>
        </div>
        <div class="mb-3">
            <label for="quantityType" class="form-label">Type</label>
            <select id="quantityType" class="form-select form-select mb-3" aria-label="Quantity Type">
                <option selected disabled>Please Select</option>
                @if (QuantityTypes != null)
                {
                    @foreach (var quant in QuantityTypes)
                    {
                        <option value="@quant.ToUpper()">@quant</option>
                    }
                }
            </select>
            <div id="quantityTypeHelp" class="form-text">Please select a type</div>
        </div>
        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input type="number" class="form-control" id="price" aria-describedby="priceHelp">
            <div id="priceHelp" class="form-text">Please provide a price greater than 0</div>
        </div>
        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </div>
    <div class="col-md-4"></div>
</EditForm>

@code {
    [Parameter] public Guid? InventoryId { get; set; }

    private string[]? QuantityTypes;

    [SupplyParameterFromForm] private InventoryDto? Inventory { get; set; }

    protected override void OnInitialized()
    {
        GetQuantityTypes();
        base.OnInitialized();
    }

    private void GetQuantityTypes()
    {
        QuantityTypes = InventoriesClient.GetQuantityTypes();
    }

    private async Task HandleSubmitAsync()
    {
        if (Inventory is null) return;

        if (InventoryId is null)
        {
            await InventoriesClient.AddNewInventory(Inventory);
        }

        NavigationManager.NavigateTo("/inventory");
    }
}