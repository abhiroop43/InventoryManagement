<div class="modal fade" id="deleteModal-@Inventory.InventoryId" tabindex="-1" aria-labelledby="deleteConfirmModalLabel"
     aria-hidden="true">
    <div class="modal-dialog p-0">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteConfirmModalLabel">Please Confirm</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete @Inventory.InventoryName? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="DeleteInventory">Delete
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public required InventoryDto Inventory { get; set; }

    private void DeleteInventory()
    {
        Console.WriteLine($"Deleting Inventory: {Inventory.InventoryId}");
    }

}